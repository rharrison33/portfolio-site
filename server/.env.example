# Port the API server listens on
API_PORT=4001

# Comma-separated list of origins allowed to call this API in production.
# For local dev, http://localhost:5173 is allowed automatically.
CORS_ORIGIN=https://yourdomain.com

# Optional: wire up real email delivery for contact form submissions.
# Without these set, submissions are still validated and saved to
# server/data/submissions.json, and logged to the console.
#
# Example using Resend (https://resend.com):
# RESEND_API_KEY=re_xxxxxxxx
# CONTACT_TO_EMAIL=you@example.com
# CONTACT_FROM_EMAIL=portfolio@yourdomain.com
